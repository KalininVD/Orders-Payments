{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "orders-api": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "payments-api": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/api/accounts/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "orders": {
        "Destinations": {
          "orders": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "payments": {
        "Destinations": {
          "payments": {
            "Address": "http://localhost:5001/"
          }
        }
      }
    },
    "Swagger": {
      "Enabled": true,
      "Endpoints": [
        {
          "Key": "orders",
          "Name": "Orders Service API",
          "Path": "/swagger/v1/swagger.json"
        },
        {
          "Key": "payments",
          "Name": "Payments Service API",
          "Path": "/swagger/v1/swagger.json"
        }
      ]
    }
  }
}