{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        }
      },
      "payments": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/payments/{**catch-all}"
        }
      },
      "swagger-orders": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/swagger/%ORDERS_SERVICE_NAME%/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/swagger/%ORDERS_SERVICE_NAME%"
          },
          {
            "PathPrefix": "/swagger"
          }
        ]
      },
      "swagger-payments": {
        "ClusterId": "payments-cluster",
        "Match": {
          "Path": "/swagger/%PAYMENTS_SERVICE_NAME%/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/swagger/%PAYMENTS_SERVICE_NAME%"
          },
          {
            "PathPrefix": "/swagger"
          }
        ]
      }
    },
    "Clusters": {
      "orders-cluster": {
        "Destinations": {
          "orders": {
            "Address": "http://%ORDERS_SERVICE_HOST%:%ORDERS_SERVICE_PORT%/"
          }
        }
      },
      "payments-cluster": {
        "Destinations": {
          "payments": {
            "Address": "http://%PAYMENTS_SERVICE_HOST%:%PAYMENTS_SERVICE_PORT%/"
          }
        }
      }
    }
  }
}