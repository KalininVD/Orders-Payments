{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "payments": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/api/accounts/{**catch-all}"
        }
      },
      "swagger-orders": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/swagger/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/swagger/orders"
          },
          {
            "PathPrefix": "/swagger"
          }
        ]
      },
      "swagger-payments": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/swagger/accounts/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/swagger/accounts"
          },
          {
            "PathPrefix": "/swagger"
          }
        ]
      }
    },
    "Clusters": {
      "orders": {
        "Destinations": {
          "orders": {
            "Address": "http://localhost:5002/"
          }
        }
      },
      "payments": {
        "Destinations": {
          "payments": {
            "Address": "http://localhost:5001/"
          }
        }
      }
    }
  }
}