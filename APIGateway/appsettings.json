{
  "Logging": {
    "LogLevel": {
      "Default": "Critical",
      "Microsoft.AspNetCore": "Critical"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/orders/{**catch-all}"
        }
      },
      "payments": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/payments/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "orders": {
        "Destinations": {
          "orders": {
            "Address": "Change this to the address of the OrdersService"
          }
        }
      },
      "payments": {
        "Destinations": {
          "payments": {
            "Address": "Change this to the address of the PaymentsService"
          }
        }
      }
    }
  }
}