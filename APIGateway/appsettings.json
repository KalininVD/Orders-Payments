{
  "Logging": {
    "LogLevel": {
      "Default": "Error"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "orders-api": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "payments-api": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/api/accounts/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "orders": {
        "Destinations": {
          "orders": {
            "Address": "Change this to the address of the OrdersService"
          }
        }
      },
      "payments": {
        "Destinations": {
          "payments": {
            "Address": "Change this to the address of the PaymentsService"
          }
        }
      }
    }
  }
}